# Local developer environment overrides (git-ignored). Copy to .env and edit.
# The Python extension loads this via python.envFile.

# Blendkit API key for authenticated search/downloads during dev.
API_KEY=

# Point at a staging server if needed (defaults to https://www.blendkit.com).
BLENDKIT_SERVER=https://www.blendkit.com

# Turn on verbose logging (bk_unreal.* loggers → DEBUG).
BLENDKIT_DEBUG=0

# Rebuild the Go client from bk_client sources on demand.
BLENDKIT_DEV=1

# Optional: path to Unreal's Python stub folder for autocompletion, e.g.
# <UE>/Engine/Plugins/Experimental/PythonScriptPlugin/Content/Python/... or the
# generated stub written to <Project>/Intermediate/PythonStub.
UE_PYTHON_STUBS=
